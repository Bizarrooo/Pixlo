DISCORD_BOT_TOKEN=put_your_bot_token_here
DISCORD_GUILD_ID=put_your_discord_server_id_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=put_your_supabase_service_role_key_here

# Optional donor tier role IDs. The bot reconciles linked Pixlo members to their
# highest earned donor tier every five minutes. Leave unset to disable role syncing.
DISCORD_DONOR_SUPPORTER_ROLE_ID=
DISCORD_DONOR_PATRON_ROLE_ID=
DISCORD_DONOR_BENEFACTOR_ROLE_ID=
DISCORD_DONOR_SPONSOR_ROLE_ID=
DISCORD_DONOR_ELITE_SPONSOR_ROLE_ID=
DISCORD_DONOR_MYTHIC_PATRON_ROLE_ID=
DISCORD_DONOR_ETERNAL_BENEFACTOR_ROLE_ID=
# Set true when Stripe uses live mode; defaults to PIXLO_PREMIUM_LIVEMODE if omitted.
PIXLO_DONATIONS_LIVEMODE=
